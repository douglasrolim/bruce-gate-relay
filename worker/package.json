{
  "name": "bruce-gate-relay-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker + Durable Object relay for bruce-gate-relay",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs --check",
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "test": "npm run build:client && vitest run",
    "test:watch": "npm run build:client && vitest",
    "typecheck": "npm run build:client && tsc --noEmit && tsc --noEmit -p client",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fake-device": "node ../tools/fake-device/fake-device.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  }
}
